      "typeVersion": 1,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const row = item.json || {};\n  const title = row.Topic || row.title || row.Question || `Knowledge row ${index + 1}`;\n  const answer = row.Answer || row.Content || row.Description || row.Response || '';\n  const category = row.Category || row.Service || 'AI automation';\n  return {\n    json: {\n      pageContent: `${title}\\nCategory: ${category}\\n${answer}`.trim(),\n      metadata: {\n        source: 'AI Sales Agent sample knowledge base',\n        row: index + 1,\n        category\n      }\n    }\n  };\n});"
      },
      "id": "prepare-documents",
      "name": "Prepare Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        0
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "documents"
      },
      "id": "insert-supabase-vector-store",
      "name": "Supabase Vector Store: Insert",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
